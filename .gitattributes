*.cmd text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cs text eol=lf
# Unity YAML uses an empty scalar as "key: "; do not treat that serialized form
# as a whitespace error while still normalizing line endings.
*.meta text eol=lf whitespace=-trailing-space
*.asset text eol=lf whitespace=-trailing-space
*.unity text eol=lf whitespace=-trailing-space
*.mat text eol=lf whitespace=-trailing-space
.gitignore text eol=lf
.gitattributes text eol=lf

# 已验收的Unity Player必须逐字节保留，避免Git在不同Windows设置下改写运行时配置。
Player_通信修复/** -text
