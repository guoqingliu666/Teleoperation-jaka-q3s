+bool EthercatMaster::initInterface(const std::string& interface) {
+  for (size_t i = 0; i < interfaces_.size(); ++i) {
+    if (interfaces_[i] == interface) return init(static_cast<int>(i));
+  }
+  ECOUT << "Requested interface not in physical adapter list: " << interface << "\n";
+  return false;
